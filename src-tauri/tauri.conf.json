{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gonagamuwa Stores",
  "version": "4.0.0",
  "identifier": "lk.gonagamuwa.stores",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "title": "ගෝනගමුව ස්ටෝර්ස්",
        "width": 1300,
        "height": 850,
        "minWidth": 810,
        "minHeight": 620,
        "backgroundColor": "#eaf6ef"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}